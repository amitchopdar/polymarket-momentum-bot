# Polymarket Prediction Bot Environment Secrets Template (.env.example)
# Rename or copy this file to .env on your server/local machine.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT!

# Telegram Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
TELEGRAM_AUTHORIZED_USER_IDS=PRIMARY_USER_ID,SECONDARY_ADMIN_USER_ID

# Polymarket Live Execution Credentials (Required ONLY for LIVE mode)
POLYMARKET_API_KEY=YOUR_POLYMARKET_API_KEY
POLYMARKET_SECRET=YOUR_POLYMARKET_SECRET
POLYMARKET_PASSPHRASE=YOUR_POLYMARKET_PASSPHRASE
POLYMARKET_PRIVATE_KEY=YOUR_POLYMARKET_PRIVATE_KEY
